# URL of the Haverstack server.
# Default: http://127.0.0.1:3000 (local dev — run haverstack/server alongside)
STACK_SERVER_URL=http://127.0.0.1:3000

# Bearer token for authenticating with the Haverstack server.
# Must match OWNER_TOKEN set on the server (or a token issued via POST /tokens).
API_TOKEN=your_token_here

# Timezone used for date display in generated pages.
TZ=America/New_York
